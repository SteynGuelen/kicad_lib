	)
	(fp_text user "Nets bind by PAD NUMBER: place the matching symbol from the .kicad_sym and run Update PCB from Schematic. Add this library as 'AntennaGenerator' (see README.md) so the symbol's Footprint property resolves."
		(at 0 31 0)
		(layer "Cmts.User")
		(uuid "5657795e-8b04-49fb-a830-f5c0bacb91ae")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(fp_text user "LIMITATION: the radiator/coil copper is footprint GRAPHICS (fp_line/fp_poly). KiCad gives footprint graphics no net, so it is drawn copper only — it does not connect in the ratsnest or DRC. Only pads carry nets."
		(at 0 33 0)
		(layer "Cmts.User")
		(uuid "2b6f926f-82be-42fb-a17a-f0fcd40c9f45")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(fp_text user "Keep-out (element_centric, 5.00mm): the four rule areas ring the antenna and forbid tracks, vias and copper pours. The feed track must still enter them; for element-centric keep-out the coil aperture must be kept clear too."
		(at 0 35 0)
		(layer "Cmts.User")
		(uuid "416474bd-29d6-416b-9561-60c4cffdee0c")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
